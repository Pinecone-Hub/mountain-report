{
  "name": "mountain-report",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"for(const d of ['.astro','node_modules/.astro'])require('fs').rmSync(d,{recursive:true,force:true})\" && astro check && astro build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/post-build.ts",
    "preview": "astro preview",
    "test": "tsc -p worker/tsconfig.json && tsc -p oauth/tsconfig.json && vitest run",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check.ts",
    "test:a11y": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/a11y.ts",
    "cms:normalise": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/cms-normalise.ts",
    "test:apache": "bash scripts/apache-test.sh",
    "test:cms": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/cms-roundtrip.ts",
    "data": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/data/process-wgms.ts",
    "figures:png": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/figures-png.ts",
    "pdfs:placeholder": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/placeholder-pdfs.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.6",
    "@axe-core/playwright": "4.14.0",
    "@types/hast": "3.0.5",
    "astro": "7.4.13",
    "pagefind": "1.6.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "satteri": "0.11.7"
  }
}
