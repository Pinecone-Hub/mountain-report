---
import { report } from "../config/report";
import { tf, t } from "../i18n/index";
import { neighbours, pageSequence } from "../lib/pagenav";
import { reportPageTitle } from "../lib/page-titles";
import { pageLink } from "../lib/urls";

interface Props {
  lang: string;
  /** Route of the current page ("summary" or a chapter id). */
  slug: string;
}

const { lang, slug } = Astro.props;
const { previous, next } = neighbours(pageSequence(report.chapters.map((c) => c.id)), slug);
// A neighbour that does not exist in this language (summary-scope languages) is the default-language page,
// so its title is shown in that language.
const link = (target: string) => {
  const l = pageLink(lang, target);
  return { ...l, title: reportPageTitle(l.hreflang ?? lang, target) };
};
const prev = previous ? link(previous) : undefined;
const nxt = next ? link(next) : undefined;
---

{
  (prev || nxt) && (
    <nav class="page-nav" aria-label={t(lang, "pagenav.label")} data-pagefind-ignore>
      {prev && (
        <a class="prev" rel="prev" href={prev.href} hreflang={prev.hreflang}>
          {tf(lang, "pagenav.previous", { title: prev.title })}
        </a>
      )}
      {nxt && (
        <a class="next" rel="next" href={nxt.href} hreflang={nxt.hreflang}>
          {tf(lang, "pagenav.next", { title: nxt.title })}
        </a>
      )}
    </nav>
  )
}

<style>
  .page-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--border);
  }

  .page-nav a {
    flex: 1 1 14rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius);
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .page-nav a:hover {
    background: var(--surface);
    text-decoration: underline;
  }

  .next {
    text-align: end;
  }

  .prev:only-child {
    flex-grow: 0;
  }
</style>
