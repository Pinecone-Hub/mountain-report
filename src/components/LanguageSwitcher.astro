---
import { report } from "../config/report";
import { t, type TranslationKey } from "../i18n/index";
import { SUMMARY_SLUG } from "../lib/page-links";
import { pageUrl } from "../lib/urls";

interface Props {
  lang: string;
  /** Page route below the language root ("about", "chapter-1"); empty for the language home. */
  switchPath?: string;
}

const { lang, switchPath = "" } = Astro.props;
// Full languages everywhere; the summary-scope languages only on the Summary (the one page they have).
const choices = report.languages.filter((l) => l.scope === "full" || switchPath === SUMMARY_SLUG);
---

<nav class="lang-switcher" aria-label={t(lang, "lang.choose")}>
  <ul>
    {
      choices.map((language) => (
        <li>
          <a
            href={pageUrl(language.code, switchPath)}
            lang={language.code}
            dir={language.dir}
            hreflang={language.code}
            aria-current={language.code === lang ? "true" : undefined}
          >
            {t(lang, `lang.${language.code}.name` as TranslationKey)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: none;
  }

  a {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    background: var(--surface);
  }

  a[aria-current="true"] {
    border-color: var(--accent);
    color: var(--accent);
    font-weight: var(--font-weight-strong);
    box-shadow: inset 0 calc(-1 * var(--space-1)) 0 -1px var(--accent);
  }
</style>
