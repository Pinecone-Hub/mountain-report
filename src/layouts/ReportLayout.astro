---
import Base from "./Base.astro";
import AuthorsBox from "../components/AuthorsBox.astro";
import CiteBox from "../components/CiteBox.astro";
import PageNav from "../components/PageNav.astro";
import ShareBox from "../components/ShareBox.astro";
import Toc from "../components/Toc.astro";
import type { Crumb, TocHeading } from "../lib/nav";

interface Props {
  lang: string;
  /** Page title: the h1 and the start of the document title. */
  title: string;
  /** Small label above the h1, for example "Chapter 1". */
  eyebrow?: string;
  switchPath?: string;
  breadcrumbs?: Crumb[];
  /** The page's h2 and h3 headings, for the side table of contents. */
  headings: TocHeading[];
  /** "page": how to cite, share, authors and previous/next (Summary and chapters). "report": how to cite the whole report. */
  extras?: "page" | "report";
}

const { lang, title, eyebrow, switchPath = "", breadcrumbs, headings, extras } = Astro.props;
---

<Base lang={lang} title={title} switchPath={switchPath} breadcrumbs={breadcrumbs}>
  <header class="report-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
  </header>
  <div class="report-layout">
    <Toc lang={lang} headings={headings} />
    <article class="report-body">
      <slot />
      {extras === "page" && (
        <>
          <CiteBox lang={lang} slug={switchPath} />
          <ShareBox lang={lang} slug={switchPath} />
          <AuthorsBox lang={lang} />
          <PageNav lang={lang} slug={switchPath} />
        </>
      )}
      {extras === "report" && <CiteBox lang={lang} slug="" />}
    </article>
  </div>
</Base>

<style>
  .report-layout {
    display: block;
  }

  .report-body {
    min-inline-size: 0;
  }

  /* The first heading of the main column starts level with the table of contents. */
  .report-body > :global(:first-child),
  .report-body > :global(:first-child > h2:first-child) {
    margin-block-start: 0;
  }

  @media (min-width: 64rem) {
    .report-layout {
      display: grid;
      grid-template-columns: var(--toc-width) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
