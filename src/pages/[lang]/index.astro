---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Contours from "../../components/Contours.astro";
import Video from "../../components/Video.astro";
import { chapterTitle } from "../../config/pages";
import { fullLanguages, report, reportTitle } from "../../config/report";
import { t, tf } from "../../i18n/index";
import { withBase } from "../../lib/paths";
import { BASE, pageUrl } from "../../lib/urls";

export function getStaticPaths() {
  return fullLanguages.map((language) => ({ params: { lang: language.code } }));
}

const { lang } = Astro.params;

// Key messages and their references come from the Home entry of the language, when it exists.
const [entry] = await getCollection("home", ({ id }) => id === `${lang}/home`);
const Content = entry ? (await render(entry)).Content : undefined;

// The "Download full report" button goes straight to the full report file when the language has one.
const fullReport = (await getCollection("downloads", ({ data }) => data.lang === lang && data.kind === "full-report")).sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const downloadHref = fullReport ? withBase(BASE, fullReport.data.file) : pageUrl(lang, "downloads");

interface Tile {
  href: string;
  label?: string;
  title: string;
}
const tiles: Tile[] = [
  { href: pageUrl(lang, "summary"), title: t(lang, "page.summary") },
  ...report.chapters.map((chapter) => ({
    href: pageUrl(lang, chapter.id),
    label: tf(lang, "chapter.label", { number: chapter.number }),
    title: chapterTitle(chapter, lang),
  })),
  { href: pageUrl(lang, "figures"), title: t(lang, "page.figures") },
  { href: pageUrl(lang, "downloads"), title: t(lang, "page.downloads") },
  { href: pageUrl(lang, "faq"), title: t(lang, "page.faq") },
  { href: pageUrl(lang, "glossary"), title: t(lang, "page.glossary") },
];
---

<Base lang={lang} title={reportTitle(lang)} description={entry?.data.description ?? t(lang, "seo.description.home")} schema="report" indexed>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 id="hero-title">{reportTitle(lang)}</h1>
      <p class="subtitle">{t(lang, "home.subtitle")}</p>
      <p>
        <a class="button" href={downloadHref} download={fullReport ? "" : undefined}>{t(lang, "home.downloadFull")}</a>
      </p>
    </div>
    <div class="hero-art"><Contours /></div>
  </section>

  <section aria-labelledby="explore">
    <h2 id="explore">{t(lang, "home.explore.title")}</h2>
    <ul class="tiles">
      {
        tiles.map((tile) => (
          <li>
            <a class="tile" href={tile.href}>
              <span class="tile-label">{tile.label}</span>
              <span class="tile-title">{tile.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    Content && (
      <section aria-labelledby="key-messages" class="key-messages">
        <h2 id="key-messages">{t(lang, "home.keyMessages.title")}</h2>
        <Content />
      </section>
    )
  }

  {
    entry?.data.video && (
      <section aria-labelledby="video" class="video-section">
        <h2 id="video">{t(lang, "video.title")}</h2>
        <Video url={entry.data.video.url} title={entry.data.video.title} publisher={entry.data.video.publisher} lang={lang} />
      </section>
    )
  }
</Base>

<style>
  .hero {
    margin-block-end: var(--space-7);
    padding-block: var(--space-7);
    border-block-end: var(--border-width) solid var(--border);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .hero-art {
    display: none;
  }

  .hero-text {
    min-inline-size: 0;
  }

  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-6);
      align-items: center;
    }

    .hero-art {
      display: block;
      block-size: 100%;
      min-block-size: 14rem;
      overflow: hidden;
    }
  }

  h1 {
    font-size: clamp(2rem, 1rem + 3vw, var(--text-3xl));
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--text);
  }

  .button {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--bg);
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .button:hover {
    text-decoration: underline;
  }

  .key-messages > :global(ol) {
    padding-inline-start: var(--space-5);
  }

  .key-messages > :global(ol > li) {
    margin-block-end: var(--space-2);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: none;
  }

  .tiles li {
    display: flex;
  }

  .tile {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
  }

  .tile:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .tile:hover .tile-title {
    text-decoration: underline;
  }

  .tile-label:empty {
    display: none;
  }

  .tile-label {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-strong);
  }

  .tile-title {
    color: var(--accent);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-strong);
    line-height: var(--leading-heading);
  }

  @media (min-width: 40rem) {
    .tile-label:empty {
      display: block;
      min-block-size: calc(var(--text-sm) * var(--leading-body));
    }
  }
</style>
