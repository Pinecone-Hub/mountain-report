---
import Base from "../layouts/Base.astro";
import { defaultLanguage, fullLanguages } from "../config/report";
import { t } from "../i18n/index";
import { withBase } from "../lib/paths";

const base = import.meta.env.BASE_URL;
const lang = defaultLanguage.code;
---

<Base lang={lang} title={t(lang, "notFound.title")}>
  <h1>{t(lang, "notFound.title")}</h1>
  <p>{t(lang, "notFound.text")}</p>
  <nav aria-label={t(lang, "lang.choose")}>
    <ul>
      {
        fullLanguages.map((language) => (
          <li>
            <a href={withBase(base, `${language.code}/`)} lang={language.code} hreflang={language.code}>
              {t(lang, `lang.${language.code}.name` as "lang.en.name")}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
