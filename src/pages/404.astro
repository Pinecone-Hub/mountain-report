---
import Base from "../layouts/Base.astro";
import { defaultLanguage } from "../config/report";
import { t } from "../i18n/index";

const lang = defaultLanguage.code;
---

<Base lang={lang} title={t(lang, "notFound.title")} description={t(lang, "seo.description.notFound")} canonicalPath={false} alternates={false}>
  <h1>{t(lang, "notFound.title")}</h1>
  <p>{t(lang, "notFound.text")}</p>
</Base>
